)


def art_key(word):
    """'Licht bewolkt' and 'lichtbewolkt' are the same drawing."""
    return "".join(
        ch for ch in (word or "").strip().lower() if ch.isalnum() or ch == "_"
    )


def ascii_art(word):
    return ART.get(art_key(word), DEFAULT_ART)


def wind_rose(deg):
    if deg is None:
        return "N/A"
    index = int(float(deg) * 16 / 360.0 + 0.5)
    if index < 0:
        index = 0
    if index > 16:
        index = 16
    return WIND[index]


def beaufort(kmh):
    """WMO Beaufort from a km/h wind. Weather.com metric wind is km/h."""
    bounds = (1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118)
    for force, limit in enumerate(bounds):
        if kmh < limit:
            return force
    return 12


def number(value):
    if value is None or value == "":
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def day_temp(value):
    reading = number(value)
    if reading is None:
        text = str(value or "").replace("&nbsp;", "").strip()
        return text
    if reading == int(reading):
        return str(int(reading))
    return f"{reading:.1f}"


def plain(text):
    text = (text or "").replace("&nbsp;", " ").replace("\xa0", " ")
    for tag in ("<br>", "<br/>", "<br />"):
        text = text.replace(tag, " ")
    return " ".join(text.split())


def fetch_json(url):
    resp = requests.get(url, timeout=15)
    resp.raise_for_status()
    if not resp.text.strip():
        raise ValueError("empty response")
    return resp.json()


def station_obs():
    data = fetch_json(STATION_URL)
    rows = data.get("observations") or []
    if not rows:
        raise ValueError("no observation")
    return rows[0]


def weerlive():
    data = fetch_json(WEERLIVE_URL)
    rows = data.get("liveweer") or []
    if not rows:
        raise ValueError("no liveweer")
    return rows[0]


def bulletin(obs, live):
    metric = obs.get("metric") or {}
    temp = number(metric.get("temp"))
    wind = number(metric.get("windSpeed"))
    pressure = number(metric.get("pressure"))
    temp_now = f"{temp:.1f}" if temp is not None else "N/A"
    low = day_temp(live.get("d0tmin"))
    high = day_temp(live.get("d0tmax"))
    if low and high:
        temp_text = f"{temp_now} ({low} tot {high})"
    else:
        temp_text = temp_now
    if wind is None:
        wind_text = "N/A"
    else:
        wind_text = f"{beaufort(wind)} Beaufort"
    if pressure is None:
        pressure_text = "N/A"
    else:
        pressure_text = f"{pressure:.1f} hPa"

    word = live.get("image") or live.get("samenv") or ""
    drawing = ascii_art(word)
    sky = plain(live.get("samenv")) or "onbekend"
    forecast = plain(live.get("verw"))

    lines = [
        " .ooO  Het Weer .Ooo" + ("-" * 57),
        f"| {drawing[0]} | Hier nu {sky}",
        f"| {drawing[1]} |",
        f"| {drawing[2]} | Temperatuur  : {temp_text} graden Celsius",
        f"| {drawing[3]} | Windsnelheid : {wind_text}",
        f"| {drawing[4]} | Windrichting : {wind_rose(obs.get('winddir'))}",
        f"| {drawing[5]} | Luchtdruk    : {pressure_text}",
        "|---------------`",
    ]
    if forecast:
        lines.append(f"| {forecast}")
    return "\n".join(lines)


def main():
    try:
        obs = station_obs()
    except Exception:
        print(f"[!] Station {STATION_ID} offline or returned no recent data.")
        return 1
    try:
        live = weerlive()
    except Exception:
        print("[!] Geen weerbericht van weerlive.nl.")
        return 1
    print(bulletin(obs, live))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
