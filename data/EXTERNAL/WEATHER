#!/usr/bin/env python3
"""//RUN WEATHER — Het Weer.

Start it from a linked channel with //RUN WEATHER, or //WEATHER (Remote must
be on). It prints one report, reads no input, and exits. Bare //RUN is
different: that sends RUN.GPI and starts nothing.

Temperature, wind, and pressure come from the Weather Underground station.
The drawing, the sky line, and the forecast come from weerlive.nl.
The drawing is chosen from the weerlive image word (lichtbewolkt, zonnig, ...).
"""

import requests

API_KEY = "<YOUR WU API KEY>"
STATION_ID = "IMUSSE20"
STATION_URL = (
    f"https://api.weather.com/v2/pws/observations/current"
    f"?stationId={STATION_ID}&format=json&units=m"
    f"&numericPrecision=decimal&apiKey={API_KEY}"
)
# Put yoru city name at the end >
WEERLIVE_URL = (
    "https://weerlive.nl/api/json-data-10min.php?key=84f2b4a2b3&locatie=Mussel"
)

# Each drawing is six lines of 13 characters. The word is the weerlive
# `image` field; a sky line such as "Licht bewolkt" is accepted too.
